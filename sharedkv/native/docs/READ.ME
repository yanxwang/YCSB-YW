## 4. 核心模块详解

### 4.1 内存管理模块 (`shared_kv_bucket.cpp`)

#### 4.1.1 内存模式

**CXL 模式（默认）**：
```cpp
void* allocate_cxl_memory(int numa_node, size_t size) {
    // 使用 mmap 分配匿名内存
    void* ptr = mmap(NULL, size, PROT_READ | PROT_WRITE,
                     MAP_PRIVATE | MAP_ANONYMOUS | MAP_POPULATE, -1, 0);

    // 绑定到指定 NUMA 节点（CXL memory）
    struct bitmask* mask = numa_allocate_nodemask();
    numa_bitmask_setbit(mask, numa_node);
    mbind(ptr, size, MPOL_BIND, mask->maskp, mask->size + 1, 0);

    return ptr;
}
```

**PMem 模式（Legacy）**：
```cpp
void* map_shared_memory(const char* device_path, size_t size) {
    int fd = open(device_path, O_RDWR);  // e.g., /dev/pmem0
    return mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
}
```

#### 4.1.2 Hash Table 数据结构

```cpp
struct SharedHashTable {
    uint64_t magic;                     // 0xC0DEBEEFDEADF00D，用于验证初始化
    std::atomic<uint64_t> free_offset;  // 线性分配器偏移
    Bucket buckets[4096];               // 4096 个 bucket
    // KV entries 在 header 之后分配
};

struct Bucket {
    SpinLock lock;        // 基于 atomic flag 的自旋锁
    uint64_t head_offset; // 指向第一个 KV entry 的偏移
};

struct KVEntry {
    uint64_t hash;        // key 的哈希值
    uint32_t key_len;     // key 长度
    uint32_t value_len;   // value 长度
    uint64_t next_offset; // 下一个 entry 的偏移（链表）
    char data[];          // 变长 key + value 数据
};
```

#### 4.1.3 KV 操作实现

**PUT 操作**：
```cpp
int kv_put(SharedHashTable* ht, void* base,
           const std::string& key, const std::string& value) {
    uint64_t h = hash_key(key);
    uint32_t bucket_id = h % NUM_BUCKETS;

    Bucket& bucket = ht->buckets[bucket_id];
    bucket.lock.lock();  // 获取 bucket 锁

    // 检查是否已存在（更新场景）
    KVEntry* existing = find_entry(bucket, base, key);
    if (existing) {
        // 更新现有 entry（如果空间足够）
        // 否则分配新空间
    } else {
        // 分配新 entry
        uint64_t entry_size = sizeof(KVEntry) + key.length() + value.length();
        uint64_t offset = ht->free_offset.fetch_add(entry_size);

        KVEntry* entry = (KVEntry*)((char*)base + offset);
        entry->hash = h;
        entry->key_len = key.length();
        entry->value_len = value.length();
        memcpy(entry->data, key.data(), key.length());
        memcpy(entry->data + key.length(), value.data(), value.length());

        // 插入到链表头
        entry->next_offset = bucket.head_offset;
        bucket.head_offset = offset;
    }

    bucket.lock.unlock();
    return 0;
}
```

**GET 操作**：
```cpp
int kv_get(SharedHashTable* ht, void* base,
           const std::string& key, std::string& value) {
    uint64_t h = hash_key(key);
    uint32_t bucket_id = h % NUM_BUCKETS;

    Bucket& bucket = ht->buckets[bucket_id];
    bucket.lock.lock();

    // 遍历链表查找
    uint64_t offset = bucket.head_offset;
    while (offset != 0) {
        KVEntry* entry = (KVEntry*)((char*)base + offset);
        if (entry->hash == h &&
            memcmp(entry->data, key.data(), key.length()) == 0) {
            // 找到了，复制 value
            value.assign(entry->data + entry->key_len, entry->value_len);
            bucket.lock.unlock();
            return 0;
        }
        offset = entry->next_offset;
    }

    bucket.lock.unlock();
    return -1;  // NOT_FOUND
}
```

### 4.2 Lock-Free 队列 (`uintr_threading.h`)

```cpp
template<typename T>
struct alignas(64) LockFreeQueue {
    T* entries;                              // 环形缓冲区
    size_t size;                             // 队列容量
    alignas(64) std::atomic<uint64_t> head;  // 消费者指针（cache line 对齐）
    alignas(64) std::atomic<uint64_t> tail;  // 生产者指针（cache line 对齐）

    LockFreeQueue(size_t capacity) : size(capacity) {
        entries = (T*)aligned_alloc(64, sizeof(T) * capacity);
    }

    bool enqueue(const T& item) {
        uint64_t current_tail = tail.load(std::memory_order_relaxed);
        uint64_t next_tail = (current_tail + 1) % size;

        // 检查队列是否满
        if (next_tail == head.load(std::memory_order_acquire))
            return false;

        entries[current_tail] = item;
        tail.store(next_tail, std::memory_order_release);
        return true;
    }

    bool dequeue(T& item) {
        uint64_t current_head = head.load(std::memory_order_relaxed);

        // 检查队列是否空
        if (current_head == tail.load(std::memory_order_acquire))
            return false;

        item = entries[current_head];
        head.store((current_head + 1) % size, std::memory_order_release);
        return true;
    }

    bool is_empty() const {
        return head.load(std::memory_order_acquire) ==
               tail.load(std::memory_order_acquire);
    }
};
```

**设计要点**：
- Cache line 对齐避免 false sharing
- Relaxed load 优化热路径
- Acquire/Release 语义保证内存顺序

### 4.3 Request/Response 结构 (`kv_request.h`)

```cpp
enum class KVOpType : uint8_t {
    READ = 0,
    INSERT = 1,
    UPDATE = 2,
    DELETE = 3
};

enum class KVStatus : uint8_t {
    SUCCESS = 0,
    NOT_FOUND = 1,
    ERROR = 2
};

struct alignas(64) KVRequest {
    KVOpType op_type;                              // 操作类型
    uint32_t client_id;                            // 客户端 ID（Synchronizer 设置）
    uint64_t sequence_number;                      // 全局序列号（Synchronizer 设置）
    uint64_t timestamp;                            // 时间戳（用于延迟测量）

    uint32_t key_len;
    char key_data[128];                            // 内联 key 存储

    uint32_t value_len;
    char* value_data;                              // 堆分配的 value（大 value）

    uint32_t target_worker_id;                     // 预计算的目标 worker
    LockFreeQueue<KVResponse>* resp_q_ptr;         // 响应队列指针（Synchronizer 设置）

    void set_key(const std::string& key);
    void set_value(const std::string& value);
    std::string get_key() const;
    std::string get_value() const;
    void cleanup();
};

struct alignas(64) KVResponse {
    KVStatus status;
    uint32_t client_id;
    uint64_t sequence_number;
    uint64_t timestamp;

    uint32_t result_len;
    char result_data[256];                         // 内联结果存储

    void set_result(const std::string& result);
    std::string get_result() const;
};
```

### 4.4 Worker 模块 (`kv_worker.cpp`)

```cpp
struct KVWorker {
    static constexpr size_t BUFFER_SIZE = 1024;  // Ring buffer 大小

    alignas(64) KVRequest* buffer[BUFFER_SIZE];  // Request 指针数组
    alignas(64) std::atomic<uint64_t> write_idx{0};  // Synchronizer 写
    alignas(64) std::atomic<uint64_t> read_idx{0};   // Worker 读

    uint32_t worker_id;
    uint32_t num_workers;

    // 统计信息
    std::atomic<uint64_t> ops_processed{0};
    std::atomic<uint64_t> reads{0};
    std::atomic<uint64_t> inserts{0};
    std::atomic<uint64_t> updates{0};
    std::atomic<uint64_t> deletes{0};

    bool try_handoff(KVRequest* req);      // Synchronizer 调用
    bool try_get_request(KVRequest*& req); // Worker 调用

    bool owns_bucket(uint32_t bucket_id) const {
        return (bucket_id % num_workers) == worker_id;
    }
};

void worker_thread_func(KVWorker* worker, SharedHashTable* table,
                        void* base, std::atomic<bool>& stop_flag) {
    while (!stop_flag.load()) {
        KVRequest* req = nullptr;

        if (worker->try_get_request(req)) {
            KVResponse resp;
            resp.client_id = req->client_id;
            resp.sequence_number = req->sequence_number;
            resp.timestamp = req->timestamp;

            // 执行 KV 操作
            switch (req->op_type) {
                case KVOpType::READ: {
                    std::string result;
                    bool found = kv_get(table, base, req->get_key(), result);
                    resp.status = found ? SUCCESS : NOT_FOUND;
                    if (found) resp.set_result(result);
                    worker->reads++;
                    break;
                }
                case KVOpType::INSERT:
                case KVOpType::UPDATE: {
                    kv_put(table, base, req->get_key(), req->get_value());
                    resp.status = SUCCESS;
                    worker->inserts++;
                    break;
                }
                case KVOpType::DELETE: {
                    bool deleted = kv_delete(table, base, req->get_key());
                    resp.status = deleted ? SUCCESS : NOT_FOUND;
                    worker->deletes++;
                    break;
                }
            }

            // 写 response 到正确的队列
            while (!req->resp_q_ptr->enqueue(resp)) {
                if (stop_flag.load()) break;
                std::this_thread::yield();
            }

            req->cleanup();
            delete req;
            worker->ops_processed++;
        } else {
            std::this_thread::yield();
        }
    }
}
```

### 4.5 Synchronizer 模块 (`kv_synchronizer.cpp`)

```cpp
void synchronizer_thread_func(
    std::vector<ClientChannel*>& clients,
    std::vector<KVWorker*>& workers,
    std::atomic<bool>& stop_flag) {

    size_t client_idx = 0;
    std::atomic<uint64_t> global_seq{0};

    while (!stop_flag.load()) {
        // Round-robin 轮询所有客户端
        for (size_t i = 0; i < clients.size(); ++i) {
            KVRequest* req = nullptr;

            if (clients[client_idx]->req_q->dequeue(req)) {
                // 分配全局序列号
                req->sequence_number = global_seq.fetch_add(1);
                req->client_id = client_idx;
                req->resp_q_ptr = clients[client_idx]->resp_q;

                // 基于 key 的 hash 选择 worker
                uint64_t h = hash_key(req->get_key());
                uint32_t bucket_id = h % NUM_BUCKETS;
                uint32_t worker_id = bucket_id % workers.size();

                // 直接交付给 worker 的 ring buffer
                if (!workers[worker_id]->try_handoff(req)) {
                    // Ring buffer 满了，返回错误响应
                    KVResponse err_resp;
                    err_resp.status = ERROR;
                    err_resp.client_id = req->client_id;
                    clients[client_idx]->resp_q->enqueue(err_resp);
                    delete req;
                }
            }

            client_idx = (client_idx + 1) % clients.size();
        }

        std::this_thread::yield();
    }
}
```

